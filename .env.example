# Copy to .env for local testing:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up --build
# In Portainer, set these in the stack's own "Environment variables" UI
# instead - never commit a real .env.

# Database
DB_PORT=5432
DB_USER=leadsales
DB_PASSWORD=change-me
DB_NAME=leadsales

# JWT secrets - use distinct random values, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Token lifetimes - access tokens are intentionally short-lived (a stolen
# access token can't be revoked before it expires, only bounded by this
# value); refresh tokens are revoked immediately on password reset,
# deactivation, or a role/team change, so this can safely be longer.
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=5h

# Public URL the app is served at in production (comma-separated if more
# than one). Any value works for the local override below.
ALLOWED_ORIGINS=https://leads.example.com

# Name of the Docker network the reverse proxy already created - find the
# real value on the VM with: docker network ls. Unused by the local
# override, which manages its own local network instead.
PROXY_NETWORK_NAME=proxy
