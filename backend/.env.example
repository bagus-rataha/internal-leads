# Required
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fiber_api
JWT_ACCESS_SECRET=your-super-access-secret-change-this
JWT_REFRESH_SECRET=your-super-refresh-secret-change-this
APP_ENV=development

# Optional (defaults shown)
JWT_ACCESS_EXPIRE=5m
JWT_REFRESH_EXPIRE=5h
PORT=8000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# Required only when APP_ENV=production
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Integration tests only (go test -tags=integration)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiber_api_test?sslmode=disable
